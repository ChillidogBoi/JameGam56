[node name="Customer2" parent="track" instance=ExtResource("4_l8phu")]
visible = false
texture = ExtResource("43_ip7ob")
id = "Police Officer"
male = true
wallet = 30.0
allowed = Array[int]([6, 5, 0, 1])
my_belt = ExtResource("44_rtoos")
wait_time = 20.0
fix_works = 100
replace_price = 30
start_dialogue = "Police Officer:I know what you're doing here. I just can't prove it... yet, but I will... Anyway this belt is busted. I want a new one. &You:Of course officer. (Eek, the police!)"
end_dialogue_yes = "Police Officer:You'll replace it? For no cost to me?.. Thanks. I guess I was wrong about this place. &You:(Phew. Please don't shut us down. My boss would be so mad.)"
end_dialogue_scam = "Police Officer:Alright, but I've got my eye on you. &You:(I'll just have to be careful. My boss would be so mad at me if we got shut down.)"
end_dialogue_no_exp = "Police Officer:You're not gonna pull one over on me.&You:(Oh no, I raised the price too high, is that illegal? He's leaving. Does that mean I'm fine?)"
end_dialogue_no_wrng = "Police Officer:Why would I want that?!&You:(Shoot, wrong one.)"
end_dialogue_no_tim = "Police Officer:You're lucky I can't wait around all day to catch you in the act.&You:(Oh well. At least he's leaving.)"
news_scammed = "Local Belt Store Closed Due to Police Investigation. &The police have declined to comment or allow the press to speak with the owner who is in prison. One local says \"Yeah, they...overcharge for [bad] belts, who [cares]? You gonna...arrest the [people who are] paying [those] prices next? This is [crazy]!\""

