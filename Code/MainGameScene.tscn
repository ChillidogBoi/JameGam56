[node name="Boss2" type="Sprite2D" parent="track" node_paths=PackedStringArray("anims")]
visible = false
texture = ExtResource("43_s4pq6")
script = ExtResource("44_y1hvh")
id = "Boss"
male = true
wants = 5
allowed = Array[int]([0, 1, 5])
my_belt = ExtResource("41_5ep8q")
wait_time = 45.0
fix_works = 100
replace_price = 30
start_dialogue = "Boss:Alright, kid. Now we’re learning repairs and replacements.&Boss:If any customer comes in blabbering about replacements, don’t give it to them.&Boss:If you replace it, you pay for it.
Now show me what you’d do in this situation."
end_dialogue_yes = "Boss:That’s it. Right on, lass. Use the box cutter for a quick fix. Some customers might be willing to buy a new belt altogether.&Boss:And if you think they’ve got money, try to upsell them.But if they get mad and leave, that’s your loss.&You:Got it, boss!&Boss:And aye! Don’t forget to put yer name on the name tag. Company policy."
end_dialogue_scam = "Boss:Open yer ears, lass! We’re not handing out free belts. This isn’t a charity shop. Don’t let me see you doing that in front of customers, or you’ll be paying the difference. Try again."
end_dialogue_no_exp = "Boss:You might sell a cheaper belt to someone else, but for this one, let’s just fix it. Ok? Let’s try again, kid."
end_dialogue_no_wrng = "Boss:You really think someone’s buying an expensive belt when they came in for a repair? That’s bad business. Try again."
end_dialogue_no_tim = "Boss:You've gotta work faster than that, lass. Dont ever let the timer run out, it’s there for a reason. Let's try that again."
anims = NodePath("AnimationPlayer")
metadata/_custom_type_script = "uid://rmhgcp2uoo8w"

