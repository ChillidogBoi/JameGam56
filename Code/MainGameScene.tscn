visible = false
texture = ExtResource("45_owyh2")
id = "Skater Girl"
wallet = 750.0
wants = 4
allowed = Array[int]([4, 6])
my_belt = ExtResource("46_yw65d")
wait_time = 20.0
replace_price = 50
start_dialogue = "Skater Goth:Yeah… i brought this belt last week and it already stopped being shiny and i like want a new one. okay?&Skater Goth:My dad’s the mayor, so just make it quick yeah?&You:(Alright, alrighttt. Don't want the mayor's kid hitting me with a city ordinance.)"
end_dialogue_yes = "Skater Goth:finally …this is shiny. thanks i guess."
end_dialogue_no_wrng = "Skater Goth:Ugh. No, not even close. Do i look like id wear this?"
end_dialogue_no_tim = "Skater Goth:Ugh, is it like your first day or something?&You:Matter of fact yeah... It is."
news_scammed = "Local Skater Crippled in Skateboarding Accident.
Wardrobe Malfunction to Blame? &A local skater was injured in a skateboarding accident yesterday, resulting in the permanent disablement of both of her legs. While she otherwise is recovering quickly, doctors say she will never walk again, confined to a wheelchair the rest of her life. Her parents declined to comment, but one of her fellow skaters that day had this to say, \"It was totally that belt's fault she crashed. It's a [lesson to all of] us, watch where you buy your belts and stuff.\" Another skater adds, \"Out of all of us, she was the one that had the best chance of going pro. She was the one that had, like, what it takes to make it. That was her dream.\" While a third had a more cynical answer, \"I hope she sues the place that sold it to her.\""

