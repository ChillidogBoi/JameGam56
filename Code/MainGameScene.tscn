[node name="Boss" type="Sprite2D" parent="track" node_paths=PackedStringArray("anims")]
visible = false
texture = ExtResource("43_s4pq6")
script = ExtResource("44_y1hvh")
id = "Boss"
male = true
wallet = 200.0
tip = -200.0
wants = 1
allowed = Array[int]([2, 3, 1, 4])
wait_time = 45.0
start_dialogue = "Boss:Hiya lass! First day, huh...
Well let's see you sell me a belt, then."
end_dialogue_yes = "Boss:Not bad, but try hovering over a customer with your mouse for helpful info.&Boss:Let's try that one more time."
end_dialogue_scam = "Boss:Do I look like a \"fashion diva\"? Open your eyes!&Boss:Let's try that one more time."
end_dialogue_no_exp = "Boss:Hmm... You ARE good... I hope you're good with that knife and marker too. &Boss:Try to make at least $250 today. Just a little test to see if we keep you.&Boss:Don't forget you can hover over customers with your mouse to see helpful info and your own face to see what you're thinking. &Boss:Some customers tell you what they want, but they'll take what you give them if they can afford it. &Boss: If you want to survive in the business world, give them the ILLUSION of helping them, while taking as much of their money as you can."
end_dialogue_no_wrng = "Boss:The cheapest one? I might fall for it... if I didn't know where it came from.&Boss:Let's try that one more time."
end_dialogue_no_tim = "Boss:You've gotta work faster than that, lass. Don't let the timer run out, it's there for a reason.&Boss:Let's try that one more time."
anims = NodePath("AnimationPlayer")
metadata/_custom_type_script = "uid://rmhgcp2uoo8w"

