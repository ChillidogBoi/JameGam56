[node name="Customer" parent="track" instance=ExtResource("4_l8phu")]
visible = false
texture = ExtResource("38_ypuxb")
id = "The Grandma"
wallet = 100.0
tip = 1.5
wants = 2
allowed = Array[int]([0, 1, 2, 3, 4])
wait_time = 45.0
start_dialogue = "Old Lady:Oh, hello, dearie. I'm sorry to be a bother, but could you please find me a red belt?&Old Lady:My eyes just don’t seem to work as they used to. &You:Sure, let's take a look."
end_dialogue_yes = "Old Lady:Oh my! This is just perfect! You have mighty good taste, dear &Old Lady:Here, take this- a little something extra for your trouble. &You:(That’s retail, baby!)"
end_dialogue_scam = "Old Lady:Thank you, dear, this will do just fine. &You:(Either she didn't notice or she didn't care. Either way money's money.)"
end_dialogue_no_exp = "Old Lady:My goodness, dear... I fear I'll have to pass on that one.&You:(Guess she didn't have as much money as I thought.)"
end_dialogue_no_wrng = "Old Lady:That won't do dearie... Sorry to be a bother.&You:(Oof, she's pretty observant for a blind lady.)"
end_dialogue_no_tim = "Old Lady:That's alright, dear. I'll come back another time. &You:(Scammed by time itself. I hate when that happens.)"
news_scammed = "Local Blind Woman Swindled! &\"I thought that nice young lady was helping me,\" says ninety-seven-year-old grandmother of seven, Example Name, \"She seemed very nice, why would she do something like this?\" Why indeed? Is this what it has come to? Taking advantage of the elderly and disabled? What a sad world."

