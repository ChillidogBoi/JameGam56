wait_time = 45.0
fix_works = 100
replace_price = 20
start_dialogue = "Very Thin Man:Uh… ‘scuse me… I bought a belt here. It’s…um, much too long. Is there any way I can trade for a shorter one?&You: Well... (My boss did say not to do replacements...)"
end_dialogue_yes = "Very Thin Man:Oh! Would…would that really be possible? Thanks, man!"
end_dialogue_scam = "Very Thin Man:Oh, okay... If you think that'll help... Thanks."
end_dialogue_no_exp = "Very Thin Man:I dont think …I can afford this..sorry man."
end_dialogue_no_tim = "Very Thin Man:Oh, sorry, I have to go. I'll just have to do without. I don't want to be late. &You:(Darn, too slow)"
news_scammed = "Reviews for Example Belt Store: &4/10: Came in for a repair and got upsold to a new one. I was able to fix the old belt at home! Terrible service."

