start_dialogue = "Celebrity:I need something fancy for my photo shoot. Money's no object, of course. Let's make this quick.&You:Quick... got it."
end_dialogue_yes = "Celebrity:Oh, this is just perfect, darling! This will be on the front cover of Vogue!"
end_dialogue_scam = "Celebrity:Cute! I like it! Toodaloo!"
end_dialogue_no_exp = "Celebrity:HA! Why would someone like me ever wear this?&You:Uh... maybe in an alternate universe where everyone loves cheap gold belts?"
