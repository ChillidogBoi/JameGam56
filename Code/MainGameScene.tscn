[node name="Boss" type="Sprite2D" parent="track" node_paths=PackedStringArray("anims")]
texture = ExtResource("43_s4pq6")
script = ExtResource("44_y1hvh")
id = "Boss"
male = true
wallet = 150.0
tip = -150.0
wants = 1
allowed = Array[int]([2, 3, 1, 4])
wait_time = 45.0
start_dialogue = "Boss:Welcome to yer first day, lass. Alright then, let’s get started. I wanna see what you're made of.&Boss:Sell me a belt. C’mon now, don't have all day."
end_dialogue_yes = "Boss:Not bad… but you’ve got to get inside the customer’s head. Try hovering your cursor over them. Try again."
end_dialogue_scam = "Boss:Open yer eyes, lass. Do I really look like some fastinista to you? Try again."
end_dialogue_no_exp = "Boss:Hmm… I see a bright future for you, kid. Maybe even a hefty paycheck.&Boss:Today I want you aiming for at least 300. Consider it my wee test to see if you’re worth keeping around.&Boss:Shouldn’t be hard for you, with that little marker on your desk. One click and you can raise the price on any belt.&Boss:Those suckers won’t know the difference.&Boss:And don’t forget- sales is all about observation. Watch people. Study them.&Boss:Some customers tell you what they want. Most don’t. But they’ll take what you give them if they can afford it.&Boss:If you want to survive in this business, you give the illusion of good service while taking everything they’ve got.&Boss:I’ve got another test for you. Let me grab a spare belt."
end_dialogue_no_wrng = "Boss:The cheap one, really? You trying to put this place out of business on day one? Let’s try that again, aye?"
end_dialogue_no_tim = "Boss:You've gotta work faster than that, lass. Dont ever let the timer run out, it’s there for a reason. Let's try that again."
anims = NodePath("AnimationPlayer")
metadata/_custom_type_script = "uid://rmhgcp2uoo8w"

